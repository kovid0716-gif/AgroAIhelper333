{
  "entities": {
    "users": {
      "title": "User",
      "description": "User profiles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "chats": {
      "title": "Chat / Diagnosis History",
      "description": "User specific plant diagnoses and conversation histories",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "plantName": { "type": "string" },
        "diseaseName": { "type": "string" },
        "severity": { "type": "string" },
        "confidence": { "type": "number" },
        "summary": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isFavorite": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "plantName", "diseaseName"]
    }
  }
}
